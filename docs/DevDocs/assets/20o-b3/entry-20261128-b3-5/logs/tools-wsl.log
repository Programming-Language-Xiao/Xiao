> wsl.exe -d Ubuntu-26.04 --cd / -- bash -lc <probe below>
cat /etc/os-release
uname -srmo
probe() {
  local executable
  executable=$(command -v "$1") || { printf "missing=%s\n" "$1"; return 1; }
  printf "> %s %s\n" "$executable" "$2"
  printf "resolved=%s\n" "$(readlink -f "$executable")"
  "$executable" "$2"
  printf "exit=%s\n" "$?"
}
printf "> rustup show active-toolchain\n"
rustup show active-toolchain
printf "exit=%s\n" "$?"
for name in rustc cargo; do
  printf "> rustup which %s\n" "$name"
  rustup which "$name"
  printf "exit=%s\n" "$?"
done
probe rustc -vV
probe cargo -Vv
for name in llvm-config clang llvm-as llc cc ld ld.lld; do
  probe "$name" --version
done
