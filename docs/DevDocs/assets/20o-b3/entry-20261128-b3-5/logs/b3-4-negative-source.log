134:fn reserved_intrinsic_ids_fail_before_execution() {
135:    let artifact = FrontendCompiler::new()
136:        .compile(&FrontendRequest::from_text("os_time_monotonic(\"ns\")\n"))
137:        .unwrap();
138:    let tac = xiao_bytecode::lower_program(&artifact.ir);
139:    assert!(
140:        tac.signatures
141:            .iter()
142:            .any(|sig| sig.intrinsic_id() == Some(50))
143:    );
144:    for id in [63] {
145:        let mut invalid = tac.clone();
146:        let mut signatures = xiao_bytecode::sig::CallSigTable::new();
147:        for signature in tac.signatures.iter() {
148:            signatures.intern(if signature.intrinsic_id() == Some(50) {
149:                xiao_bytecode::sig::CallSig::intrinsic(id)
150:            } else {
151:                signature.clone()
152:            });
153:        }
154:        invalid.signatures = signatures;
155:        assert!(xiao_bytecode::encode_xiaoc(&invalid, Default::default()).is_err());
156:        let result = xiao_vm::run_request(&xiao_vm::RunRequest::new(&artifact.ir, &invalid));
157:        assert!(!result.result.is_success(), "reserved {id}");
158:        assert!(
159:            result.events.iter().all(|event| !matches!(
160:                event,
161:                VmEvent::ModuleLoaded { .. } | VmEvent::IntrinsicOutput { .. }
162:            )),
163:            "reserved {id} reached the application: {result:?}"
164:        );
165:    }
166:}
