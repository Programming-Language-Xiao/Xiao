core/rust/crates/xiao-bytecode/src/encode/tests.rs:680-715
680:fn decoded_intrinsic_ids_are_checked_in_both_operand_widths() {
681:    for width in [OperandWidth::Leb128, OperandWidth::FixedU16] {
682:        let mut program = all_ops_program();
683:        program.signatures.intern(CallSig::intrinsic(34));
684:        let encoded = encode(&program, width).expect("活动 ID 应可编码");
685:        let mut table = Writer::new(width);
686:        encode_signatures(&mut table, &program.signatures).expect("活动签名表应可编码");
687:        let starts = encoded
688:            .bytes
689:            .windows(table.bytes.len())
690:            .enumerate()
691:            .filter_map(|(offset, bytes)| (bytes == table.bytes).then_some(offset))
692:            .collect::<Vec<_>>();
693:        assert_eq!(starts.len(), 1, "应唯一定位完整签名表，不能误改其它字段");
694:
695:        // 只替换刚追加的最后一条签名，不调用会提前拒绝未知 ID 的编码校验。
696:        let signature_bytes = |id: u32| {
697:            let mut writer = Writer::new(width);
698:            writer.uleb(0); // 空形参表。
699:            write_optional_index(&mut writer, Some(id & 0xffff)).unwrap();
700:            write_optional_index(&mut writer, Some(id >> 16)).unwrap();
701:            writer.byte(10); // IrType::Dynamic。
702:            writer.bytes
703:        };
704:        let valid = signature_bytes(34);
705:        assert!(table.bytes.ends_with(&valid));
706:        let end = starts[0] + table.bytes.len();
707:        for id in [63, 100, u32::MAX] {
708:            let mut bytes = encoded.bytes.clone();
709:            bytes.splice(end - valid.len()..end, signature_bytes(id));
710:            let expected = EncodeError::InvalidFormat(format!("未知或已废弃的 intrinsic ID {id}"));
711:            assert_eq!(decode(&bytes), Err(expected.clone()));
712:            assert_eq!(decode_encoded(&bytes), Err(expected));
713:        }
714:    }
715:}
core/rust/crates/xiao-bytecode/tests/b4_cmath_tac.rs:338-380
338:fn cmath_unknown_intrinsic_ids_are_rejected_before_encoding() {
339:    let (_, ir, tac, cases) = fixture();
340:    let case = cases.first().expect("应存在 cmath 调用");
341:    let (function_index, _) = tac
342:        .functions
343:        .iter()
344:        .enumerate()
345:        .find(|(_, function)| function.name == case.function)
346:        .unwrap();
347:
348:    for id in [63, 100, u32::MAX] {
349:        let mut invalid = tac.clone();
350:        let invalid_signature = invalid.signatures.intern(CallSig::intrinsic(id));
351:        let function = &mut invalid.functions[function_index];
352:        let instruction = function
353:            .blocks
354:            .iter_mut()
355:            .flat_map(|block| &mut block.instructions)
356:            .find(|instruction| matches!(instruction.op, TacOp::Call { .. }))
357:            .expect("应找到可替换的 intrinsic 调用");
358:        let TacOp::Call { signature, .. } = &mut instruction.op else {
359:            unreachable!();
360:        };
361:        *signature = invalid_signature;
362:
363:        let validation =
364:            verify_production(&ir, &invalid).expect_err("生产校验必须拒绝未知/墓碑 intrinsic ID");
365:        let reason = format!("未知或已废弃的 intrinsic ID {id}");
366:        assert_eq!(validation.code, TAC_STRUCTURE_CODE);
367:        assert!(
368:            validation.message.ends_with(&reason),
369:            "校验错误应指出 ID {id}：{validation}"
370:        );
371:        for width in [OperandWidth::Leb128, OperandWidth::FixedU16] {
372:            assert_eq!(
373:                encode(&invalid, width),
374:                Err(EncodeError::InvalidFormat(reason.clone())),
375:                "{width:?} 编码错误必须指出 ID {id}"
376:            );
377:        }
378:        println!("B4-2A-NEGATIVE id={id} verifier=reject encoder=reject result=passed");
379:    }
380:}
core/rust/crates/xiao-driver/tests/20o_b2_b2_divide.rs:26-80
26:fn lfloat_divide_requires_the_frozen_public_contract() {
27:    let valid = "lfloat_divide(lfloat(1),lfloat(2),3,\"half_even\")";
28:    for expression in [
29:        "lfloat_divide()",
30:        "lfloat_divide(lfloat(1),lfloat(2),3)",
31:        "lfloat_divide(1,lfloat(2),3,\"half_even\")",
32:        "lfloat_divide(lfloat(1),1,3,\"half_even\")",
33:        "lfloat_divide(lfloat(1),lfloat(2),sint(3),\"half_even\")",
34:        "lfloat_divide(lfloat(1),lfloat(2),3,true)",
35:        "lfloat_divide(lfloat(1),lfloat(2),3,\"half_even\",0)",
36:        "lfloat_divide(numerator=lfloat(1),denominator=lfloat(2),precision=3,typo=\"half_even\")",
37:        "lfloat_divide(lfloat(1),numerator=lfloat(2),precision=3,rounding=\"half_even\")",
38:    ] {
39:        assert!(
40:            FrontendCompiler::new()
41:                .compile(&FrontendRequest::from_text(format!(
42:                    "print({expression})\n"
43:                )))
44:                .is_err(),
45:            "{expression}"
46:        );
47:    }
48:    assert!(
49:        FrontendCompiler::new()
50:            .compile(&FrontendRequest::from_text(format!("print({valid})\n")))
51:            .is_ok()
52:    );
53:    let decl = xiao_intrinsics::by_name("lfloat_divide").unwrap();
54:    assert_eq!(decl.id.get(), 33);
55:    assert_eq!(decl.effects, xiao_intrinsics::Effects::Allocates);
56:    assert_eq!(decl.capability, xiao_intrinsics::Capability::None);
57:    for id in 34..=48 {
58:        let internal =
59:            xiao_intrinsics::active_by_id(xiao_intrinsics::IntrinsicId::new(id).unwrap())
60:                .expect("B3-3已登记34～48内部声明");
61:        assert_eq!(internal.kind, xiao_intrinsics::IntrinsicKind::Cmath);
62:        assert_eq!(
63:            internal.signature.parameter,
64:            xiao_intrinsics::ValueType::Float
65:        );
66:        assert_eq!(
67:            internal.signature.return_type,
68:            xiao_intrinsics::ValueType::Float
69:        );
70:        assert_eq!(internal.effects, xiao_intrinsics::Effects::Pure);
71:        assert_eq!(internal.capability, xiao_intrinsics::Capability::None);
72:    }
73:    assert!(
74:        xiao_intrinsics::active_by_id(xiao_intrinsics::IntrinsicId::new(63).unwrap()).is_none()
75:    );
76:    assert!(
77:        xiao_intrinsics::active_by_id(xiao_intrinsics::IntrinsicId::new(100).unwrap()).is_none()
78:    );
79:    assert_eq!(xiao_runtime_abi::ABI_MINOR_VERSION, 20);
80:}
