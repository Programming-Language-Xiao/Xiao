216:fn vm_rejects_invalid_shapes_types_and_unknown_ids() {
217:    for (index, (name, entry)) in entries().into_iter().enumerate() {
218:        let base = injection_program(index, false);
219:        let parameters =
220:            xiao_intrinsics::cmath_parameters(IntrinsicId::new(34 + index as u32).unwrap())
221:                .unwrap();
222:        for value in [
223:            RuntimeValue::Int(1),
224:            RuntimeValue::Sint(1),
225:            RuntimeValue::Sfloat(1.0),
226:            RuntimeValue::Lint("1".into()),
227:            RuntimeValue::Lfloat("1".into()),
228:            RuntimeValue::Bool(true),
229:            RuntimeValue::None,
230:            RuntimeValue::new_string("1").unwrap(),
231:        ] {
232:            for slot in 0..if matches!(entry, Entry::Binary(_)) {
233:                2
234:            } else {
235:                1
236:            } {
237:                // 完整类型检查必须先于其余实参的 NaN 域错误。
238:                let mut values =
239:                    vec![RuntimeValue::Float(f64::NAN); base.functions[0].parameters.len()];
240:                values[slot] = value.clone();
241:                let result = injected(&base, &values, 0);
242:                assert_eq!(
243:                    result.result.error_code(),
244:                    Some("X06-RUNTIME-002"),
245:                    "{name}: {result:?}"
246:                );
247:            }
248:        }
249:        for mutation in 0..6 {
250:            let mut program = base.clone();
251:            let unknown =
252:                (mutation == 5).then(|| program.signatures.intern(CallSig::intrinsic(63)));
253:            let mut changed = false;
254:            for instruction in program.functions[0]
255:                .blocks
256:                .iter_mut()
257:                .flat_map(|b| &mut b.instructions)
258:            {
259:                if let TacOp::Call {
260:                    signature,
261:                    arguments,
262:                    ..
263:                } = &mut instruction.op
264:                    && program
265:                        .signatures
266:                        .get(*signature)
267:                        .unwrap()
268:                        .intrinsic_id()
269:                        .is_some_and(|id| id == 34 + index as u32)
270:                {
271:                    match mutation {
272:                        0 => {
273:                            arguments.pop();
274:                        }
275:                        1 => arguments.push(arguments[0].clone()),
276:                        2 => arguments[0].name = Some("unknown".into()),
277:                        3 if arguments.len() == 2 => {
278:                            arguments[0].name = Some(parameters[0].0.into());
279:                        }
280:                        4 if arguments.len() == 2 => {
281:                            for arg in arguments.iter_mut() {
282:                                arg.name = Some(parameters[0].0.into());
283:                            }
284:                        }
285:                        5 => *signature = unknown.unwrap(),
286:                        _ => continue,
287:                    }
288:                    changed = true;
289:                }
290:            }
291:            if !changed {
292:                continue;
293:            }
294:            if mutation == 5 {
295:                assert!(encode(&program, OperandWidth::Leb128).is_err());
296:            } else {
297:                let values = vec![RuntimeValue::Float(-1.0); base.functions[0].parameters.len()];
298:                let result = injected(&program, &values, 0);
299:                assert_eq!(
300:                    result.result.error_code(),
301:                    Some("X06-RUNTIME-002"),
302:                    "{name} mutation={mutation}: {result:?}"
303:                );
304:            }
305:        }
306:    }
