from std.env import get, set, unset
from std.time import monotonic
def env_matches(str name, str expected) -> bool
    count = 0
    valid = true
    for value in get(name)
        count = count + 1
        if value != expected
            valid = false
    return count == 1 and valid
def env_missing(str name) -> bool
    missing = true
    for value in get(name)
        missing = false
    return missing
