# Xiao 官方 text 模块（20C 首批、20I/20M 文本接口）。
#
# 主要使用已探测的 for/while 迭代器、条件判断和布尔赋值；`lower_ascii` 另使用语言内建
# `int` 码点转换与第七批语言能力入口 `chr`。`split` 仅依赖 `array_push` intrinsic，
# 其余查找和切片语义均由 Xiao 源码实现。
def contains_char(str text, str needle) -> bool
    found = false
    for c in text
        if c == needle
            found = true
    return found

def length(str text) -> int
    count = 0
    for c in text
        count = count + 1
    return count

def is_ascii_upper(str value) -> bool
    return value >= "A" and value <= "Z"

def lower_ascii(str value) -> str
    result = ""
    for c in value
        if is_ascii_upper(c)
            result = result + chr(int(c) + 32)
        else
            result = result + c
    return result

def find(str text, str needle) -> int
    needle_length = length(needle)
    if needle_length == 0
        return 0
    text_length = length(text)
    if needle_length > text_length
        return -1
    start = 0
    while start <= text_length - needle_length
        offset = 0
        matched = true
        while offset < needle_length
            if text[start + offset] != needle[offset]
                matched = false
                break
            offset = offset + 1
        if matched
            return start
        start = start + 1
    return -1

def slice(str text, int start, int end) -> str
    text_length = length(text)
    if start < 0 or end < 0 or start > text_length or end > text_length
        raise Error(code = "TEXT_SLICE_OUT_OF_RANGE")
    if start > end
        return ""
    result = ""
    index = start
    while index < end
        result = result + text[index]
        index = index + 1
    return result

def split(str text, str separator) -> [str]
    separator_length = length(separator)
    if separator_length == 0
        raise Error(code = "TEXT_SPLIT_EMPTY_SEPARATOR")
    text_length = length(text)
    result = []
    start = 0
    cursor = 0
    while cursor <= text_length - separator_length
        tail = slice(text, cursor, text_length)
        offset = find(tail, separator)
        if offset < 0
            break
        match = cursor + offset
        array_push(result, slice(text, start, match))
        cursor = match + separator_length
        start = cursor
    array_push(result, slice(text, start, text_length))
    return result

# 仅剥除首尾六种 ASCII 空白，内部和其他 Unicode 空白保留。
def trim(str text) -> str
    whitespace = " \t\r\n" + chr(11) + chr(12)
    start = 0
    end = length(text)
    while start < end and contains_char(whitespace, text[start])
        start = start + 1
    while end > start and contains_char(whitespace, text[end - 1])
        end = end - 1
    return slice(text, start, end)

# 按原串从左到右匹配，跳过已匹配的 needle，不重新扫描 replacement。
def replace_all(str text, str needle, str replacement) -> str
    needle_length = length(needle)
    if needle_length == 0
        return text
    text_length = length(text)
    cursor = 0
    result = ""
    while cursor <= text_length - needle_length
        offset = find(slice(text, cursor, text_length), needle)
        if offset < 0
            break
        match = cursor + offset
        result = result + slice(text, cursor, match) + replacement
        cursor = match + needle_length
    return result + slice(text, cursor, text_length)

# 按计数的二进制位拼接，避免逐次追加完整输入造成反复复制。
def repeat(str text, int count) -> str
    if count <= 0 or text == ""
        return ""
    result = ""
    chunk = text
    remaining = count
    while remaining > 0
        if remaining % 2 == 1
            result = result + chunk
        remaining = remaining // 2
        if remaining > 0
            chunk = chunk + chunk
    return result

def upper_ascii(str text) -> str
    result = ""
    for c in text
        if c >= "a" and c <= "z"
            result = result + chr(int(c) - 32)
        else
            result = result + c
    return result
