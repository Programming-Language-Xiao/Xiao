# Xiao 官方 path 模块（20C 首批、20M 文本提取）。
#
# 只把 / 视为分隔符；不规范化，不解析 . 或 ..，反斜杠与盘符是普通文本。
def join(str base, str leaf) -> str
    return base + "/" + leaf

def basename(str path) -> str
    result = ""
    for c in path
        if c == "/"
            result = ""
        else
            result = result + c
    return result

def dirname(str path) -> str
    end = 0
    index = 0
    for c in path
        if c == "/"
            end = index
        index = index + 1
    result = ""
    index = 0
    for c in path
        if index >= end
            break
        result = result + c
        index = index + 1
    return result

def extension(str path) -> str
    result = ""
    found = false
    for c in path
        if c == "/"
            result = ""
            found = false
        else
            if c == "."
                result = "."
                found = true
            else
                if found
                    result = result + c
    return result
