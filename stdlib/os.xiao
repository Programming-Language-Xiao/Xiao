# Xiao 官方 os 模块（20D 文件/目录与进程 API）。
#
# 公开函数只做薄包装；内部 intrinsic 使用 os_ 前缀，避免与本模块导出递归。
def open_file(str path, /) -> file
    return os_open_file(path)

def open_directory(str path, /) -> directory
    return os_open_directory(path)

def close(resource value, /) -> none
    return os_close(value)

def read_text(file value, /) -> str
    return os_read_text(value)

# program 是单个程序名或路径；不经过 shell，也不接受命令行参数。
def spawn(str program, /) -> process
    return os_spawn(program)

def wait(process value, /) -> int
    return os_wait(value)

# 只释放进程句柄，不等待或终止子进程；wait 是唯一回收入口。
def close_process(process value, /) -> none
    return os_close_process(value)
