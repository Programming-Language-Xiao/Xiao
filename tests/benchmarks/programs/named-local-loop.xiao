def benchmark(int rounds) -> int
    flag = false
    flag = flag + 1
    flag = flag - 2
    total = 0
    index = 0
    one = 1
    two = 2
    three = 3
    four = 4
    five = 5
    six = 6
    seven = 7
    eight = 8
    nine = 9
    ten = 10
    while index != rounds
        a = index + one
        b = a + two
        c = b + three
        d = c + four
        e = d + five
        f = e + six
        g = f + seven
        h = g + eight
        i = h + nine
        j = i + ten
        total = total + j
        index = index + one
    return total
