def lower_ascii(str text) -> str
    result = ""
    for c in text
        if c == "A"
            result = result + "a"
        elif c == "B"
            result = result + "b"
        elif c == "C"
            result = result + "c"
        elif c == "D"
            result = result + "d"
        elif c == "E"
            result = result + "e"
        elif c == "F"
            result = result + "f"
        elif c == "G"
            result = result + "g"
        elif c == "H"
            result = result + "h"
        elif c == "I"
            result = result + "i"
        elif c == "J"
            result = result + "j"
        elif c == "K"
            result = result + "k"
        elif c == "L"
            result = result + "l"
        elif c == "M"
            result = result + "m"
        elif c == "N"
            result = result + "n"
        elif c == "O"
            result = result + "o"
        elif c == "P"
            result = result + "p"
        elif c == "Q"
            result = result + "q"
        elif c == "R"
            result = result + "r"
        elif c == "S"
            result = result + "s"
        elif c == "T"
            result = result + "t"
        elif c == "U"
            result = result + "u"
        elif c == "V"
            result = result + "v"
        elif c == "W"
            result = result + "w"
        elif c == "X"
            result = result + "x"
        elif c == "Y"
            result = result + "y"
        elif c == "Z"
            result = result + "z"
        else
            result = result + c
    return result

print(lower_ascii("ABCXYZ"))
print(lower_ascii("abcxyz"))
print(lower_ascii("Az-9"))
print(lower_ascii(""))
