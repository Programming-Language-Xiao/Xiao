from stdlib.text import length, slice

def probe_extension(str path) -> str
    dot = -1
    index = 0
    for c in path
        if c == "/"
            dot = -1
        else
            if c == "."
                dot = index
        index = index + 1
    if dot < 0
        return ""
    return slice(path, dot, length(path))

for path in ["", "name", "/", "/name", "a/", "a/b", "a//b", "//", "a//", ".env", "dir.x/.env", "a.tar.gz", "file.", ".", "..", "a/../b", "C:\\tmp\\file.txt", "目录/小😀.x"]
    print("[" + probe_extension(path) + "]")
