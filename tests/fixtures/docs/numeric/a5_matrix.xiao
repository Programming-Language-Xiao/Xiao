lint compound = 7
compound += 2
compound *= 3
compound -= 1
compound //= 2
compound %= 5
compound **= 2
print(compound)
lfloat decimal_compound = lfloat("7.00")
decimal_compound += 2
decimal_compound *= 2
decimal_compound /= 4
decimal_compound //= lfloat("2.0")
decimal_compound %= lfloat("1.5")
print(decimal_compound)

