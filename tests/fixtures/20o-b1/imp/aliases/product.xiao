from std.math import min as scalar_min, max as scalar_max
from std.statistics import min as list_min, max as list_max

print(scalar_min(-4, 9))
print(list_min([7, -2, 5]))
print(scalar_max(-4, 9))
print(list_max([7, -2, 5]))
print(scalar_min(right = 2, left = 7))
print(list_min(values = [3, 1]))
print(scalar_max(right = 2, left = 7))
print(list_max(values = [3, 1]))

def from_scalars() -> int
    from std.math import min
    return min(right = 4, left = 8)

def from_list() -> int
    from std.statistics import min
    return min(values = [6, 2])

print(from_list())
print(from_scalars())
