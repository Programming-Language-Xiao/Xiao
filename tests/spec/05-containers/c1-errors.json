{
  "stage": "03B",
  "status": "verified-static",
  "cases": [
    {
      "name": "zero-step",
      "source": "items = [1, 2]\nvalue = items{0}[=]\n",
      "expect": "error",
      "diagnostics": ["X03-TYPE-009"]
    },
    {
      "name": "negative-random-count",
      "source": "items = [1, 2]\nvalue = items[?-1]\n",
      "expect": "error",
      "diagnostics": ["X03-TYPE-010"]
    },
    {
      "name": "without-replacement-too-many",
      "source": "items = [1, 2]\nvalue = items[?3]\n",
      "expect": "error",
      "diagnostics": ["X03-TYPE-011"]
    },
    {
      "name": "unordered-dictionary-advanced-selection",
      "source": "table = {name = \"x\", level = 1}\nvalue = table[0, 1]\n",
      "expect": "error",
      "diagnostics": ["X03-TYPE-008"]
    },
    {
      "name": "range-crosses-unordered-dictionary",
      "source": "items = [{nested = <a = 1, b = 2>}, 1]\nvalue = items[0/nested/0~0/nested/1]\n",
      "expect": "error",
      "diagnostics": ["X03-TYPE-008"]
    },
    {
      "name": "broadcast-requires-scalar",
      "source": "items = [1, 2]\nitems[0, 1] = [3, 4]\n",
      "expect": "error",
      "diagnostics": ["X03-TYPE-012"]
    },
    {
      "name": "random-seed-invalid",
      "source": "random.seed(-1)\nrandom.seed(1.5)\n",
      "expect": "error",
      "diagnostics": ["X03-TYPE-013"]
    },
    {
      "name": "random-seed-arity",
      "source": "random.seed()\n",
      "expect": "error",
      "diagnostics": ["X03-TYPE-014"]
    }
  ]
}
